<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Meira K — Defending the West</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --navy: #0d1b2e;
    --red: #d92929;
    --cream: #f5efe3;
    --white: #ffffff;
    --dark: #0a0f1a;
    --gold: #e8c96a;
  }
  html { scroll-behavior: smooth; }
  body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--navy); overflow-x: hidden; }

  /* ─── ANNOUNCEMENT TICKER ─── */
  .ticker-wrap {
    background: var(--red);
    overflow: hidden;
    padding: 10px 0;
  }
  .ticker-inner { display: flex; width: max-content; animation: tickerL 30s linear infinite; }
  .ticker-item {
    white-space: nowrap;
    padding: 0 60px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 1px;
    color: #fff;
  }
  .ticker-dot { color: rgba(255,255,255,0.4); margin: 0 8px; }
  @keyframes tickerL { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @keyframes tickerR { from { transform: translateX(-50%); } to { transform: translateX(0); } }

  /* ─── NAV ─── */
  nav {
    background: var(--cream);
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 48px;
    border-bottom: 1px solid rgba(13,27,46,0.1);
    position: sticky; top: 0; z-index: 100;
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    letter-spacing: 2px;
    color: var(--navy);
    line-height: 1;
  }
  .nav-links { display: flex; gap: 32px; list-style: none; }
  .nav-links a {
    font-size: 12px; font-weight: 500; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--navy); text-decoration: none;
  }
  .nav-links a:hover { color: var(--red); }
  .nav-cta {
    background: var(--red); color: #fff;
    padding: 11px 24px; font-size: 12px; font-weight: 500;
    letter-spacing: 1px; text-transform: uppercase;
    border: none; cursor: pointer; font-family: 'DM Sans', sans-serif;
  }
  .nav-cta:hover { background: #b51f1f; }

  /* ─── HERO — split, cream left / navy right ─── */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 88vh;
  }

  /* LEFT */
  .hero-left {
    background: var(--cream);
    padding: 88px 64px;
    display: flex; flex-direction: column; justify-content: center;
    position: relative;
  }
  .hero-eyebrow {
    font-size: 11px; letter-spacing: 4px; text-transform: uppercase;
    color: var(--red); font-weight: 500; margin-bottom: 22px;
  }
  .hero-headline {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(72px, 9vw, 124px);
    line-height: 0.88;
    color: var(--navy);
  }
  .hero-headline .italic-line {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic; font-weight: 700;
    color: var(--red);
    font-size: clamp(84px, 10.5vw, 142px);
    line-height: 0.85;
    display: block;
  }
  .hero-sub {
    font-size: 16px; line-height: 1.75; color: #3a4a60;
    max-width: 400px; margin: 28px 0 36px;
  }
  .hero-cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 36px; }
  .btn-primary {
    background: var(--red); color: #fff;
    padding: 15px 32px; font-size: 13px; font-weight: 500;
    letter-spacing: 1px; text-transform: uppercase;
    border: none; cursor: pointer; font-family: 'DM Sans', sans-serif;
  }
  .btn-primary:hover { background: #b51f1f; }
  .btn-outline {
    background: transparent; color: var(--navy);
    padding: 14px 32px; font-size: 13px; font-weight: 500;
    letter-spacing: 1px; text-transform: uppercase;
    border: 2px solid rgba(13,27,46,0.28); cursor: pointer;
    font-family: 'DM Sans', sans-serif;
  }
  .btn-outline:hover { background: var(--navy); color: #fff; border-color: var(--navy); }
  .social-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .follow-label { font-size: 11px; color: #8a9ab0; letter-spacing: 1px; text-transform: uppercase; margin-right: 4px; }
  .social-pill {
    border: 1.5px solid rgba(13,27,46,0.2);
    padding: 6px 14px; font-size: 11px; font-weight: 500;
    letter-spacing: 1px; color: var(--navy); cursor: pointer;
  }
  .social-pill:hover { background: var(--navy); color: #fff; }

  /* RIGHT */
  .hero-right {
    background: var(--navy);
    padding: 88px 64px;
    display: flex; flex-direction: column; justify-content: center;
    position: relative; overflow: hidden;
  }
  .hero-right::before {
    content: '';
    position: absolute; top: -100px; right: -100px;
    width: 400px; height: 400px;
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: 50%;
  }
  .about-eyebrow {
    font-size: 10px; letter-spacing: 4px; text-transform: uppercase;
    color: var(--red); font-weight: 500; margin-bottom: 24px;
    display: flex; align-items: center; gap: 10px;
  }
  .about-eyebrow::before { content: '◆'; font-size: 8px; }
  .hero-right h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(48px, 5.5vw, 78px);
    line-height: 0.93; color: #fff;
  }
  .hero-right h2 em {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic; color: var(--red);
    font-size: clamp(56px, 6.5vw, 90px);
  }
  .hero-right p {
    font-size: 15px; line-height: 1.8;
    color: rgba(255,255,255,0.58);
    margin-top: 26px; max-width: 380px;
  }
  .hero-photo {
    width: 100%; max-width: 200px; margin-top: 36px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    aspect-ratio: 3/4;
    display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.15); font-size: 11px;
    letter-spacing: 2px; text-transform: uppercase;
  }

  /* ─── STATS BANNER ─── */
  .stats-banner { background: var(--red); overflow: hidden; }
  .stats-inner { display: flex; }
  .stats-left-block {
    background: var(--navy); padding: 30px 44px; min-width: 240px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .stats-left-block .eyebrow { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.32); }
  .stats-left-block h3 { font-family: 'Bebas Neue', sans-serif; font-size: 38px; line-height: 1; color: #fff; margin-top: 4px; }
  .stats-left-block h3 em { font-family: 'Cormorant Garamond', serif; font-style: italic; color: var(--red); }
  .stats-grid { display: flex; flex: 1; }
  .stat-item { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 26px 28px; border-left: 1px solid rgba(255,255,255,0.15); }
  .stat-num { font-family: 'Bebas Neue', sans-serif; font-size: 36px; color: #fff; letter-spacing: 1px; }
  .stat-label { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.48); margin-top: 2px; }

  /* ─── SHOWS ─── */
  .shows { background: var(--cream); padding: 96px 0 0; }
  .section-header { padding: 0 64px 56px; }
  .section-eyebrow { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  .section-title { font-family: 'Bebas Neue', sans-serif; font-size: clamp(44px, 5vw, 68px); line-height: 1; color: var(--navy); }
  .section-title em { font-family: 'Cormorant Garamond', serif; font-style: italic; color: var(--red); }

  /* Red top border before show grid */
  .shows-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 4px solid var(--red);
  }

  /* THE PUSHBACK — navy */
  .show-pushback {
    background: var(--navy); padding: 68px;
    position: relative; overflow: hidden;
  }
  .show-pushback::after {
    content: ''; position: absolute; bottom: -70px; right: -70px;
    width: 260px; height: 260px;
    border: 1px solid rgba(255,255,255,0.05); border-radius: 50%;
  }
  .show-tag {
    display: inline-block; padding: 4px 14px;
    font-size: 10px; letter-spacing: 2px; text-transform: uppercase;
    font-weight: 500; margin-bottom: 22px;
  }
  .tag-daily { background: var(--red); color: #fff; }
  .tag-weekly { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.7); }
  .tag-weekly-mk { background: var(--red); color: #fff; }

  .show-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(52px, 5.5vw, 84px);
    line-height: 0.9; color: #fff;
  }
  .show-name em {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic; color: var(--red);
    font-size: clamp(60px, 6.5vw, 96px);
  }
  .show-desc {
    font-size: 15px; line-height: 1.75;
    color: rgba(255,255,255,0.55);
    margin: 22px 0 32px; max-width: 370px;
  }
  .show-sub-btn {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--red); color: #fff;
    padding: 13px 26px; font-size: 12px; font-weight: 500;
    letter-spacing: 1px; text-transform: uppercase;
    border: none; cursor: pointer; font-family: 'DM Sans', sans-serif;
    margin-bottom: 10px; text-decoration: none;
  }
  .show-sub-btn:hover { background: #b51f1f; }
  .show-platforms { font-size: 12px; color: rgba(255,255,255,0.3); }
  .show-platforms a { color: rgba(255,255,255,0.48); text-decoration: underline; cursor: pointer; }

  .latest-eps { margin-top: 40px; }
  .latest-label { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.26); margin-bottom: 14px; }
  .ep-row { display: flex; align-items: center; gap: 14px; padding: 13px 0; border-top: 1px solid rgba(255,255,255,0.07); }
  .play-c {
    width: 34px; height: 34px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; cursor: pointer;
  }
  .play-c svg { width: 12px; height: 12px; fill: #fff; margin-left: 2px; }
  .ep-body { flex: 1; }
  .ep-badge { font-size: 9px; letter-spacing: 2px; text-transform: uppercase; font-weight: 500; }
  .ep-title { font-size: 13px; color: #fff; line-height: 1.4; margin-top: 3px; }
  .ep-meta { font-size: 11px; color: rgba(255,255,255,0.27); margin-top: 2px; }

  .show-footer-stats {
    display: flex; gap: 28px;
    margin-top: 32px; padding-top: 26px;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .sfs .n { font-family: 'Bebas Neue', sans-serif; font-size: 26px; color: #fff; }
  .sfs .l { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.27); }

  /* THE MEIRA K SHOW — cream */
  .show-meirak {
    background: var(--cream); padding: 68px;
    position: relative; overflow: hidden;
    border-left: 1px solid rgba(13,27,46,0.1);
  }
  .show-meirak::before {
    content: ''; position: absolute; top: -70px; right: -70px;
    width: 280px; height: 280px;
    border: 1px solid rgba(217,41,41,0.07); border-radius: 50%;
  }
  .show-name-mk { color: var(--navy); }
  .show-name-mk em { color: var(--red); }
  .show-desc-mk { color: rgba(13,27,46,0.52); }
  .show-sub-btn-mk {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--navy); color: #fff;
    padding: 13px 26px; font-size: 12px; font-weight: 500;
    letter-spacing: 1px; text-transform: uppercase;
    border: none; cursor: pointer; font-family: 'DM Sans', sans-serif;
    margin-bottom: 10px;
  }
  .show-sub-btn-mk:hover { background: var(--red); }
  .show-platforms-mk { font-size: 12px; color: rgba(13,27,46,0.3); }
  .show-platforms-mk a { color: rgba(13,27,46,0.48); text-decoration: underline; cursor: pointer; }
  .latest-label-mk { color: rgba(13,27,46,0.26); }
  .ep-row-mk { border-top-color: rgba(13,27,46,0.08); }
  .ep-title-mk { color: var(--navy); }
  .ep-meta-mk { color: rgba(13,27,46,0.3); }
  .sfs-mk .n { color: var(--navy); }
  .sfs-mk .l { color: rgba(13,27,46,0.27); }
  .show-footer-stats-mk { border-top-color: rgba(13,27,46,0.08); }

  /* ─── INNER CIRCLE LAUNCH TICKER ─── */
  .launch-ticker { background: var(--red); overflow: hidden; padding: 12px 0; }
  .launch-ticker-inner { display: flex; width: max-content; animation: tickerL 18s linear infinite; }
  .launch-item {
    white-space: nowrap; padding: 0 40px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 14px; letter-spacing: 3px; color: #fff;
  }
  .launch-item .sep { margin: 0 36px; opacity: 0.4; }

  /* ─── YOUTUBE COMMENTS ─── */
  .comments { background: var(--white); padding: 96px 0; overflow: hidden; }
  .comments .section-header { padding: 0 64px 48px; }
  .comments-track { overflow: hidden; }
  .comments-row { display: flex; gap: 18px; width: max-content; margin-bottom: 18px; }
  .comments-row.row-1 { animation: tickerL 36s linear infinite; }
  .comments-row.row-2 { animation: tickerR 42s linear infinite; }
  .comment-card {
    background: var(--cream); padding: 24px;
    min-width: 295px; max-width: 315px; flex-shrink: 0;
  }
  .comment-header { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .comment-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bebas Neue', sans-serif; font-size: 17px;
    color: #fff; flex-shrink: 0;
  }
  .av-r { background: var(--red); }
  .av-n { background: var(--navy); }
  .av-d { background: #1a6b73; }
  .av-g { background: #a0760a; }
  .comment-name { font-size: 13px; font-weight: 600; color: var(--navy); }
  .comment-likes { font-size: 11px; color: #8a9ab0; margin-top: 1px; }
  .comment-text { font-size: 14px; line-height: 1.62; color: #3a4a60; }

  /* ─── INNER CIRCLE ─── */
  .inner-circle {
    background: var(--navy);
    display: grid; grid-template-columns: 1fr 1fr;
    min-height: 540px;
  }
  .ic-left { padding: 84px 64px; display: flex; flex-direction: column; justify-content: center; }
  .ic-pill {
    display: inline-block; background: var(--red); color: #fff;
    padding: 5px 16px; font-size: 10px; letter-spacing: 3px;
    text-transform: uppercase; font-weight: 500;
    margin-bottom: 24px; width: fit-content;
  }
  .ic-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(58px, 6vw, 92px);
    line-height: 0.92; color: #fff;
  }
  .ic-title em { font-family: 'Cormorant Garamond', serif; font-style: italic; color: var(--red); }
  .ic-desc { font-size: 16px; line-height: 1.75; color: rgba(255,255,255,0.58); margin: 22px 0 34px; max-width: 370px; }
  .ic-btn-row { display: flex; gap: 0; }
  .ic-btn-a {
    background: var(--red); color: #fff; border: none;
    padding: 14px 28px; font-size: 12px; font-weight: 500;
    letter-spacing: 1px; text-transform: uppercase;
    cursor: pointer; font-family: 'DM Sans', sans-serif;
  }
  .ic-btn-a:hover { background: #b51f1f; }
  .ic-btn-b {
    background: transparent; color: rgba(255,255,255,0.55);
    border: 2px solid rgba(255,255,255,0.2);
    padding: 12px 22px; font-size: 12px; font-weight: 500;
    letter-spacing: 1px; text-transform: uppercase;
    cursor: pointer; font-family: 'DM Sans', sans-serif;
  }
  .ic-right { padding: 84px 64px; display: flex; flex-direction: column; justify-content: center; gap: 22px; }
  .ic-perk { display: flex; align-items: flex-start; gap: 18px; }
  .ic-num { font-family: 'Bebas Neue', sans-serif; font-size: 24px; color: rgba(255,255,255,0.18); min-width: 30px; line-height: 1.1; }
  .ic-perk-text h4 { font-size: 14px; font-weight: 600; color: #fff; margin-bottom: 3px; }
  .ic-perk-text p { font-size: 13px; color: rgba(255,255,255,0.42); line-height: 1.5; }

  /* ─── DIVIDER TICKER ─── */
  .divider-ticker {
    background: var(--cream);
    border-top: 1px solid rgba(13,27,46,0.07);
    border-bottom: 1px solid rgba(13,27,46,0.07);
    overflow: hidden; padding: 11px 0;
  }
  .divider-inner { display: flex; width: max-content; animation: tickerL 22s linear infinite; }
  .div-item { white-space: nowrap; padding: 0 32px; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: rgba(13,27,46,0.26); font-weight: 500; }
  .div-item em { color: var(--red); font-style: normal; }

  /* ─── SOCIALS ─── */
  .socials { background: var(--cream); padding: 84px 64px; text-align: center; }
  .socials h3 { font-family: 'Bebas Neue', sans-serif; font-size: 52px; color: var(--navy); margin-bottom: 10px; }
  .socials p { color: #8a9ab0; font-size: 15px; margin-bottom: 36px; }
  .social-grid { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
  .social-btn { display: flex; align-items: center; gap: 10px; padding: 13px 26px; border: 2px solid rgba(13,27,46,0.18); color: var(--navy); font-size: 12px; font-weight: 500; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; }
  .social-btn:hover { background: var(--navy); color: #fff; border-color: var(--navy); }

  /* ─── MERCH ─── */
  .merch { background: var(--white); padding: 96px 64px; }
  .merch-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-top: 48px; }
  .merch-card { background: var(--cream); }
  .merch-img { background: #e5dfd5; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: #b0a898; }
  .merch-info { padding: 20px; }
  .merch-name { font-size: 14px; font-weight: 500; color: var(--navy); margin-bottom: 4px; }
  .merch-price { font-size: 16px; font-weight: 700; color: var(--red); margin-bottom: 14px; }
  .merch-btn { width: 100%; background: var(--navy); color: #fff; border: none; padding: 12px; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; cursor: pointer; font-family: 'DM Sans', sans-serif; font-weight: 500; }
  .merch-btn:hover { background: var(--red); }

  /* ─── FOOTER ─── */
  footer { background: var(--dark); padding: 68px; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 48px; }
  .footer-logo { font-family: 'Bebas Neue', sans-serif; font-size: 32px; letter-spacing: 2px; color: var(--navy); background: var(--cream); display: inline-block; padding: 5px 16px; margin-bottom: 16px; }
  .footer-tagline { font-size: 14px; color: rgba(255,255,255,0.32); line-height: 1.65; max-width: 240px; }
  .footer-col h4 { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.22); margin-bottom: 20px; }
  .footer-links { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .footer-links li a { font-size: 14px; color: rgba(255,255,255,0.46); text-decoration: none; }
  .footer-links li a:hover { color: var(--red); }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,0.06); padding-top: 28px; display: flex; justify-content: space-between; align-items: center; }
  .footer-copy { font-size: 12px; color: rgba(255,255,255,0.16); }
  .footer-socials { display: flex; gap: 8px; }
  .f-soc { width: 30px; height: 30px; border: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-size: 10px; color: rgba(255,255,255,0.26); cursor: pointer; }
  .f-soc:hover { border-color: var(--red); color: var(--red); }
</style>
</head>
<body>

<!-- ANNOUNCEMENT TICKER -->
<div class="ticker-wrap">
  <div class="ticker-inner">
    <span class="ticker-item">The Inner Circle is launching soon <span class="ticker-dot">·</span> Join the waitlist</span>
    <span class="ticker-item">The Inner Circle is launching soon <span class="ticker-dot">·</span> Join the waitlist</span>
    <span class="ticker-item">The Inner Circle is launching soon <span class="ticker-dot">·</span> Join the waitlist</span>
    <span class="ticker-item">The Inner Circle is launching soon <span class="ticker-dot">·</span> Join the waitlist</span>
    <span class="ticker-item">The Inner Circle is launching soon <span class="ticker-dot">·</span> Join the waitlist</span>
    <span class="ticker-item">The Inner Circle is launching soon <span class="ticker-dot">·</span> Join the waitlist</span>
    <span class="ticker-item">The Inner Circle is launching soon <span class="ticker-dot">·</span> Join the waitlist</span>
    <span class="ticker-item">The Inner Circle is launching soon <span class="ticker-dot">·</span> Join the waitlist</span>
  </div>
</div>

<!-- NAV -->
<nav>
  <div class="nav-logo">MEIRA K.</div>
  <ul class="nav-links">
    <li><a href="#shows">Shows</a></li>
